{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["es2022", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "mockupPreviewPlugin.js",
    "vite.config.js"
  ]
}
