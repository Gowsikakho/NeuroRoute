# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Local simulator databases and generated experiment outputs.
artifacts/neuroroute-sdn/backend/data/
artifacts/neuroroute-sdn/backend/models/*.pt
artifacts/neuroroute-sdn/generated-artifacts/
/experiments/data/
**/__pycache__/
*.pyc
